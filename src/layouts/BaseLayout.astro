---
import '../assets/styles/base.css'
import { SITE_TITLE, DESCRIPTION } from '../consts'
import Head from './Head.astro'
---

<!doctype html>
<html lang="en">
  <Head title={SITE_TITLE} description={DESCRIPTION} />
  <body
    class="text-secondary-100 bg-secondary-950 min-h-screen flex flex-col"
  >
    <slot />
    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
