---
import Link from './Link.astro'

type Props = {
  href: string
  rel?: string
  target?: string
  isBlank?: boolean
  isExternal?: boolean
  class?: string
}

const {
  href,
  class: classList,
  isExternal,
  rel = '',
  target = '',
  isBlank,
  ...rest
} = Astro.props
---

<Link href={href} rel={rel} target={target} isBlank isExternal>
  <button
    type="button"
    class="text-primary-400 border border-primary-400 hover:bg-primary-400/10 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center flex items-center gap-2"
    style="box-shadow: 0 0 12px 2px rgba(45, 212, 191, 0.3)"
    {...rest}
  >
    <slot />
  </button>
</Link>
