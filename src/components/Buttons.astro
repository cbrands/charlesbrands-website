---
import Button from './Button.astro'
import { Icon } from 'astro-icon/components'

type Props = {
  demoLink?: string
  codeLink?: string
  class?: string
}
const { demoLink, codeLink, class: classList } = Astro.props
---

<div class:list={['flex gap-4 items-center', classList]}>
  {
    demoLink && (
      <Button href={demoLink} class="btn-demo" isExternal isBlank>
        <Icon name="ion--rocket" />
        Live Demo
      </Button>
    )
  }
  {
    codeLink && (
      <Button href={codeLink} class="btn-code" isExternal isBlank>
        <Icon name="ion--code-slash" />
        View Code
      </Button>
    )
  }
</div>
