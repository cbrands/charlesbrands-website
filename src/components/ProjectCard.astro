---
import { type CollectionEntry } from 'astro:content'
import Buttons from './Buttons.astro'
import { Image } from 'astro:assets'
import Heading from './Heading.astro'
import Tags from './Tags.astro'
import Link from './Link.astro'

type Props = {
  project: CollectionEntry<'projects'>
}
const { project } = Astro.props
---

<article
  class="bg-secondary-800 border border-secondary-700 rounded-lg shadow overflow-hidden flex flex-col"
>
  <Link href={`/projects/${project.data.slug}`}>
    <Image
      alt=""
      src={project.data.cover}
      width={1024}
      height={1024 / 1.5}
      format="webp"
      class="w-full rounded-t-lg"
    />
  </Link>
  <div class="px-4 pt-3 pb-4 flex flex-col flex-1">
    <Tags tags={project.data.tags} class="mb-3" />
    <Link href={`/projects/${project.data.slug}`}>
      <Heading
        text={project.data.title}
        tagName="h2"
        size="h3"
        class=""
      />
      <p class="text-sm text-secondary-400 mt-1 mb-2">
        {project.data.publishDate.toUTCString().slice(0, -13)}
      </p>
      <p class="text-sm font-normal text-secondary-400 line-clamp-2 mb-3">
        {project.body}
      </p>
    </Link>
    <Buttons
      demoLink={project.data.demoLink}
      codeLink={project.data.codeLink}
    />
  </div>
</article>
